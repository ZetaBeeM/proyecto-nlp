    "procesos": "Procesos: definición, espacio de direcciones, PCB, estados, context switch",
    "api_procesos": "API de procesos: fork, exec, wait",
    "lde": "Mecanismo: ejecución directa limitada (LDE), modos, traps, timer interrupt",
    "lab_xv6": "Laboratorio xv6 y git",
    "sched_basico": "Planificación de CPU: métricas, FIFO, SJF, STCF, Round Robin",
    "mlfq": "Planificación: Multi-Level Feedback Queue (MLFQ)",
    "sched_proporcional": "Planificación proporcional: lottery y stride scheduling",
    "sched_multiprocesador": "Planificación multiprocesador: caché, afinidad, SQMS, MQMS",
    "threads": "Threads, condiciones de carrera y sección crítica",
    "locks": "Locks: implementaciones, soporte de hardware, spin/ticket locks, colas",
    "variables_condicion": "Variables de condición y estructuras de datos concurrentes",
    "semaforos": "Semáforos, productor/consumidor y deadlocks",
    "bugs_concurrencia": "Bugs de concurrencia: violación de atomicidad y de orden",
    "espacio_direcciones": "Virtualización de memoria: espacio de direcciones y API de memoria",
    "traduccion_direcciones": "Traducción de direcciones: base y bounds (reubicación dinámica)",
    "segmentacion": "Segmentación y fragmentación externa",
    "paginacion": "Paginación y tablas de páginas",
    "tlb": "Translation Lookaside Buffer (TLB)",
    "tablas_multinivel": "Tablas de páginas más pequeñas: multinivel e invertidas",
    "swap": "Swap: espacio de intercambio, present bit, page fault",
    "reemplazo_paginas": "Políticas de reemplazo de páginas: óptima, FIFO, random, LRU, clock, thrashing",
